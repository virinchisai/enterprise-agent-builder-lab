{
  "swagger": "2.0",
  "info": {
    "title": "Enterprise Agent Builder",
    "version": "2.0"
  },
  "host": "example.invalid",
  "basePath": "/",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "entra": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/authorize",
      "tokenUrl": "https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/oauth2/v2.0/token",
      "scopes": {
        "api://example/Tickets.Access": "Access tickets on behalf of the user"
      }
    }
  },
  "security": [
    {
      "entra": [
        "api://example/Tickets.Access"
      ]
    }
  ],
  "paths": {
    "/tickets": {
      "post": {
        "operationId": "createTicket",
        "summary": "Create a ticket after explicit user confirmation",
        "description": "Create a ticket after explicit user confirmation",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "category",
                "summary"
              ],
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "vpn",
                    "hardware",
                    "access"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 5,
                  "maxLength": 500
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "ticket_id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "approval_id": {
                  "type": "string"
                },
                "replayed": {
                  "type": "boolean"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/tickets/{ticket_id}": {
      "get": {
        "operationId": "getTicket",
        "summary": "Get your own ticket status",
        "description": "Get your own ticket status",
        "parameters": [
          {
            "name": "ticket_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "category": {
                  "type": "string"
                },
                "summary": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/knowledge": {
      "get": {
        "operationId": "searchKnowledge",
        "summary": "Search synthetic IT policy",
        "description": "Search synthetic IT policy",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string"
                },
                "hits": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string"
                      },
                      "section": {
                        "type": "integer"
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/approvals/{approval_id}": {
      "get": {
        "operationId": "getApproval",
        "summary": "Read approval status",
        "description": "Read approval status",
        "parameters": [
          {
            "name": "approval_id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "ticket": {
                  "type": "string"
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "schema": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
